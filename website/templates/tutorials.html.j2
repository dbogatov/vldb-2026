{% extends "templates/layout.html.j2" %}

{% block title %}Conference Program - Tutorials{% endblock %}

{% set current = "tutorials" %}

{% block content %}
    <section class="program-tutorials">
        <h1>{{ data.name }}: Accepted Tutorials</h1>

        <div class="tutorial-table-wrapper">
            <table class="tutorial-table">
                <thead>
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Authors</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tutorial in tutorials.tutorials %}
                        <tr>
                            <td>{{ tutorial.title }}</td>
                            <td>{{ tutorial.authors }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
